---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { Textarea } from "@/components/ui/textarea";

export const prerender = false;

const url = new URL(Astro.request.url);
const error = url.searchParams.get("error");
---

<Layout title="Przerwa | PomoStretch">
  <div class="flex min-h-[70vh] flex-col items-center justify-center p-4">
    <div class="w-full max-w-md space-y-8">
      <div class="text-center">
        <h1 class="text-3xl font-bold tracking-tight">Czas na przerwę!</h1>
        <p class="text-muted-foreground mt-4">Wybierz na czym chcesz się skupić lub wpisz własne potrzeby.</p>
      </div>

      {error && <div class="bg-destructive/15 text-destructive rounded-md p-3 text-center text-sm">{error}</div>}

      <form method="POST" action="/api/break-input" class="space-y-6">
        <div class="grid grid-cols-2 gap-4">
          <Button type="submit" name="quickPick" value="Tylko oczy" variant="outline" className="h-16 text-lg"
            >Tylko oczy</Button
          >
          <Button type="submit" name="quickPick" value="Tylko kark" variant="outline" className="h-16 text-lg"
            >Tylko kark</Button
          >
          <Button type="submit" name="quickPick" value="Ogólne" variant="outline" className="h-16 text-lg"
            >Ogólne</Button
          >
          <Button type="submit" name="quickPick" value="Zaskocz mnie" variant="outline" className="h-16 text-lg"
            >Zaskocz mnie</Button
          >
        </div>

        <div class="relative flex items-center py-2">
          <div class="flex-grow border-t"></div>
          <span class="text-muted-foreground mx-4 flex-shrink-0 text-sm">LUB</span>
          <div class="flex-grow border-t"></div>
        </div>

        <div class="space-y-4">
          <Textarea
            name="freeText"
            placeholder="Opisz jak się czujesz, np. 'bolą mnie plecy od siedzenia'"
            className="min-h-[100px] resize-none"
          />
          <Button type="submit" className="h-12 w-full text-lg">Wygeneruj zestaw</Button>
        </div>
      </form>

      <div class="pt-4 text-center">
        <a href="/dashboard" class="text-muted-foreground hover:text-primary text-sm underline"
          >Pomiń przerwę i wróć do dashboardu</a
        >
      </div>
    </div>
  </div>
</Layout>
