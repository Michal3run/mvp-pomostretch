---
import Layout from "@/layouts/Layout.astro";

export const prerender = false;
---

<Layout title="Przerwa | PomoStretch">
  <div class="flex min-h-[50vh] flex-col items-center justify-center p-4 text-center">
    <h1 class="text-3xl font-bold tracking-tight">M3: Break Input Placeholder</h1>
    <p class="text-muted-foreground mt-4">Tu znajdzie się formularz przerwy i wybór ćwiczeń budowany w ramach M3.</p>
    <a href="/dashboard" class="text-primary hover:text-primary/80 mt-8 text-sm underline">Powrót do dashboardu</a>
  </div>
</Layout>
