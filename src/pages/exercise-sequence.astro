---
import Layout from "@/layouts/Layout.astro";
import ExerciseSequence from "@/components/ExerciseSequence";
import { createClient } from "@/lib/supabase";
import type { Exercise, BreakInputCookie } from "@/types";

export const prerender = false;

const cookie = Astro.cookies.get("pomostretch.break_input");
if (!cookie) {
  return Astro.redirect("/break-input");
}

let breakInput: BreakInputCookie;
try {
  breakInput = cookie.json() as BreakInputCookie;
} catch {
  return Astro.redirect("/break-input");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let catalog: Exercise[] = [];

if (supabase) {
  // Ensure Supabase SSR client resolves user session so JWT auth header is attached for native RLS
  await supabase.auth.getUser();
  const { data, error } = await supabase.from("exercise").select("*");
  if (error) {
    console.error("Failed to fetch exercise catalog:", error);
  } else {
    catalog = data as Exercise[];
  }
}
---

<Layout title="Zestaw ćwiczeń | PomoStretch">
  <div class="flex min-h-[80vh] flex-col items-center justify-center p-4">
    <ExerciseSequence client:load breakInput={breakInput} catalog={catalog} />
  </div>
</Layout>
