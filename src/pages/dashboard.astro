---
import Layout from "@/layouts/Layout.astro";
import PomodoroTimer from "@/components/PomodoroTimer";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen flex-col items-center justify-center p-4">
    <div
      class="mb-8 w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-6 text-center text-white backdrop-blur-xl"
    >
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Witaj, <span class="font-semibold text-white">{user?.email}</span>
      </h1>
      <form method="POST" action="/api/auth/signout" class="mt-2">
        <button type="submit" class="text-sm text-blue-100/50 underline transition-colors hover:text-white">
          Wyloguj się
        </button>
      </form>
    </div>

    <div class="w-full max-w-md">
      <PomodoroTimer client:load />
    </div>
  </div>
</Layout>
