---
import Topbar from "@/components/Topbar.astro";

const user = Astro.locals.user;
---

<div class="bg-cosmic relative flex min-h-screen w-full flex-col overflow-hidden">
  <!-- Cosmic orbs -->
  <div
    class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-[300px] w-[300px] -translate-x-1/2 rounded-full bg-indigo-400/10 blur-[140px]"
  >
  </div>

  <!-- Star field -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px), radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px), radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px); background-size: 200px 200px, 150px 150px, 100px 100px; background-position: 0 0, 40px 60px, 80px 30px;"
  >
  </div>

  <div class="relative z-10 flex-grow p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-20 text-center sm:py-28 lg:py-32">
      <div
        class="mb-6 inline-flex items-center rounded-full border border-purple-500/30 bg-purple-500/10 px-4 py-1.5 text-sm font-medium text-purple-200"
      >
        <span class="mr-2 flex h-2 w-2 animate-pulse rounded-full bg-purple-400"></span>
        Dla programistów i pracowników biurowych
      </div>

      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
      >
        Skup się na kodzie.<br />Rozciągaj tam, gdzie boli.
      </h1>

      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-blue-100/70 sm:text-xl">
        PomoStretch to inteligentna pętla produktywności. Połącz 25-minutowe cykle głębokiej pracy ze
        spersonalizowanymi, 3-minutowymi przerwami na regenerację — dobranymi do Twojego bólu.
      </p>

      <div class="mb-10 flex flex-wrap items-center justify-center gap-3">
        <span
          class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-medium text-blue-200 backdrop-blur-sm"
          >#kark</span
        >
        <span
          class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-medium text-blue-200 backdrop-blur-sm"
          >#oczy</span
        >
        <span
          class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-medium text-blue-200 backdrop-blur-sm"
          >#barki</span
        >
        <span
          class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-medium text-blue-200 backdrop-blur-sm"
          >#lędźwie</span
        >
      </div>

      <div class="flex w-full flex-col justify-center gap-4 sm:w-auto sm:flex-row">
        {
          user ? (
            <>
              <a
                href="/dashboard"
                class="group inline-flex items-center justify-center rounded-lg bg-purple-600 px-8 py-3.5 text-base font-semibold text-white transition-all hover:bg-purple-500 hover:shadow-lg hover:shadow-purple-500/25"
              >
                Przejdź do Dashboardu
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </>
                </svg>
              </a>
              <a
                href="/history"
                class="inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/5 px-8 py-3.5 text-base font-medium text-white backdrop-blur-sm transition-all hover:border-white/30 hover:bg-white/10"
              >
                Twoja historia
              </a>
            </>
          ) : (
            <>
              <a
                href="/auth/signup"
                class="group inline-flex items-center justify-center rounded-lg bg-purple-600 px-8 py-3.5 text-base font-semibold text-white transition-all hover:bg-purple-500 hover:shadow-lg hover:shadow-purple-500/25"
              >
                Zacznij za darmo
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </>
                </svg>
              </a>
              <a
                href="/auth/signin"
                class="inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/5 px-8 py-3.5 text-base font-medium text-white backdrop-blur-sm transition-all hover:border-white/30 hover:bg-white/10"
              >
                Zaloguj się
              </a>
            </>
          )
        }
      </div>
    </div>

    <!-- Workflow Section -->
    <div class="mx-auto max-w-5xl px-4 py-16">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white">Pętla PomoStretch</h2>
        <p class="mx-auto max-w-2xl text-blue-100/60">
          Zaprojektowana, by utrzymywać flow i redukować fizyczne napięcie bez odchodzenia od biurka.
        </p>
      </div>

      <div class="relative grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Connecting line for desktop -->
        <div
          class="absolute top-1/2 left-0 z-0 hidden h-0.5 w-full -translate-y-1/2 bg-gradient-to-r from-transparent via-purple-500/30 to-transparent md:block"
        >
        </div>

        <div
          class="relative z-10 flex flex-col items-center rounded-2xl border border-white/10 bg-gray-900/50 p-8 text-center backdrop-blur-xl transition duration-300 hover:border-purple-500/30"
        >
          <div
            class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-purple-500/20 text-purple-300 ring-1 ring-purple-500/30"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg
            >
          </div>
          <h3 class="mb-2 text-xl font-semibold text-white">Krok 1: 25 min Skupienia</h3>
          <p class="text-sm leading-relaxed text-blue-100/70">
            Timer Pomodoro z ochroną sesji. Pracuj w głębokim skupieniu bez obaw, że odświeżenie strony przerwie Twój
            cykl.
          </p>
        </div>

        <div
          class="relative z-10 flex flex-col items-center rounded-2xl border border-white/10 bg-gray-900/50 p-8 text-center backdrop-blur-xl transition duration-300 hover:border-purple-500/30"
        >
          <div
            class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-blue-500/20 text-blue-300 ring-1 ring-blue-500/30"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M2 12h4l3-9 5 18 3-9h5"></path></svg
            >
          </div>
          <h3 class="mb-2 text-xl font-semibold text-white">Krok 2: 3s Diagnozy</h3>
          <p class="text-sm leading-relaxed text-blue-100/70">
            Krótka przerwa. Szybki wybór miejsca dyskomfortu: kark, oczy, barki, plecy, lub po prostu odpoczynek.
          </p>
        </div>

        <div
          class="relative z-10 flex flex-col items-center rounded-2xl border border-white/10 bg-gray-900/50 p-8 text-center backdrop-blur-xl transition duration-300 hover:border-purple-500/30"
        >
          <div
            class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-pink-500/20 text-pink-300 ring-1 ring-pink-500/30"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"
              ></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"
              ></path></svg
            >
          </div>
          <h3 class="mb-2 text-xl font-semibold text-white">Krok 3: Spersonalizowana Ulga</h3>
          <p class="text-sm leading-relaxed text-blue-100/70">
            Ćwiczenia dopasowane do bólu, z systemem anty-powtórkowym. Koniec z monotonnymi rutynami.
          </p>
        </div>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto max-w-5xl px-4 py-16">
      <div class="mb-12 text-center">
        <h2 class="text-2xl font-bold text-white">Dlaczego PomoStretch?</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div
          class="rounded-xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl transition-colors hover:bg-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mb-4 text-purple-400"><path d="m12 14 4-4"></path><path d="M3.34 19a10 10 0 1 1 17.32 0"></path></svg
          >
          <h3 class="mb-2 text-lg font-semibold text-white">Inteligentny Rule Engine</h3>
          <p class="text-sm leading-relaxed text-blue-100/60">
            Nasz algorytm precyzyjnie dobiera ćwiczenia na podstawie Twojego zgłoszonego dyskomfortu. Dba o to, by
            rutyny były różnorodne, unikając tych samych ćwiczeń z rzędu.
          </p>
        </div>

        <div
          class="rounded-xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl transition-colors hover:bg-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mb-4 text-purple-400"
            ><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"
            ></path></svg
          >
          <h3 class="mb-2 text-lg font-semibold text-white">Ergonomia bez siłowni</h3>
          <p class="text-sm leading-relaxed text-blue-100/60">
            Wszystkie zestawy ćwiczeń są w 100% dostosowane do środowiska biurowego. Zrobisz je bez maty, bez sprzętu i
            bez odchodzenia od biurka.
          </p>
        </div>

        <div
          class="rounded-xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl transition-colors hover:bg-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mb-4 text-purple-400"
            ><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg
          >
          <h3 class="mb-2 text-lg font-semibold text-white">Dziennik i Postępy</h3>
          <p class="text-sm leading-relaxed text-blue-100/60">
            Każda sesja jest zapisywana w Twojej prywatnej historii z możliwością dodawania notatek. Zobacz, jak zmienia
            się Twoje samopoczucie w czasie.
          </p>
        </div>

        <div
          class="rounded-xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl transition-colors hover:bg-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mb-4 text-purple-400"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
          <h3 class="mb-2 text-lg font-semibold text-white">Prywatność i Szybkość</h3>
          <p class="text-sm leading-relaxed text-blue-100/60">
            Twoje dane są chronione bezpiecznymi regułami RLS w Supabase, a sama aplikacja działa błyskawicznie dzięki
            Cloudflare Edge SSR. Zero spowolnień.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="mt-auto w-full border-t border-white/10 bg-black/20 backdrop-blur-lg">
    <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-4 py-8 md:flex-row">
      <div class="flex items-center gap-2">
        <div class="h-6 w-6 rounded-full bg-gradient-to-br from-purple-500 to-blue-500"></div>
        <span class="font-semibold text-white">PomoStretch</span>
      </div>
      <p class="text-sm text-blue-100/50">
        &copy; {new Date().getFullYear()} PomoStretch. Projekt MVP — 10xDevs.
      </p>
      <div class="flex gap-4 text-sm text-blue-100/70">
        <a href="https://github.com/Michal3run/mvp-pomostretch" class="transition-colors hover:text-purple-300">GitHub</a>
      </div>
    </div>
  </footer>
</div>
